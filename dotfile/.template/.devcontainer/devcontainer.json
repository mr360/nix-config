{
	"name": "[_HERE_] Development Container",
	"build": { "dockerfile": "Dockerfile" },

	//"features": {},
	//"forwardPorts": [],
	//"remoteUser": ""
	//"containerUser": "",
	//"customizations": {},
	//"postCreateCommand": [ ],
	//"postStartCommand": [ ],
	"mounts": [
   	"source=${localEnv:HOME}/.config/nvim/init.lua,target=/home/vscode/.config/nvim/init.lua,type=bind,consistency=cached",   // Allow mounting of VIM config
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",                   // Allow SSH passthrough for git
		"source=${localEnv:HOME}/.config/git/config,target=/home/vscode/.gitconfig,type=bind,consistency=cached",       // Assume git identity
		"source=${localEnv:HOME}/.inputrc,target=/home/vscode/.inputrc,type=bind,consistency=cached",           // Set terminal input style 
	],
  "containerEnv": {
    "NVIM_DEVCONTAINER_CONFIG": "${containerWorkspaceFolder}/.devcontainer/neovim.lua"
  }
	//"runArgs": []
}
